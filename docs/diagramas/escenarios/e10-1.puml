@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>cr10a : Credencial</u>" as cr10a {
  codigo = "CR-10A"
  estado = "canjeada"
  nfcActual = "NFC-10A"
  estadoPulsera = "activa"
}
object "<u>tcAV : TipoCredencial</u>" as tcAV {
  nombre = "Abono VIP 2027"
  perfilAcceso = "VIP"
  validez = "todas las jornadas"
}
object "<u>zvip : Zona</u>" as zvip {
  nombre = "Patio VIP"
  aforoMaximo = 1200
  /ocupacionActual = 1200
}
object "<u>acc10a1 : Acceso</u>" as acc10a1 {
  id = "ACC-10A-1"
  tipoMovimiento = "entrada"
  resultado = "permitido"
}

cr10a -- tcAV : tipoCredencial
acc10a1 -- cr10a : credencial
acc10a1 -- zvip : zona

note bottom of zvip
Entrada permitida: perfil VIP, pulsera activa
y 1.199/1.200 de aforo. La ocupación queda en 1.200.
end note
@enduml
