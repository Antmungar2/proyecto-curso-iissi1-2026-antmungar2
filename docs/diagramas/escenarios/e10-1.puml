object "sergio : Usuario" as sergio {
  id = "USR-CTL-01"
  nombre = "Sergio"
  fechaNacimiento = "15/06/1994"
  rol = "personal de control del recinto"
}
object "acc10a0 : Acceso" as acc10a0 {
  id = "ACC-10A-0"
  fechaHora = "21/05/2027 17:55:00"
  tipoMovimiento = "entrada"
  resultado = "permitido"
  motivo = null
}
object "acc10a1 : Acceso" as acc10a1 {
  id = "ACC-10A-1"
  fechaHora = "21/05/2027 18:00:00"
  tipoMovimiento = "entrada"
  resultado = "permitido"
  motivo = null
}

ed2027 -- tcAV : edicion
tcAV -- cr10a : tipoCredencial
elena -- cr10a : titular
acc10a0 -- cr10a : credencial
acc10a0 -- zgen : zona
acc10a0 -- sergio : validador
acc10a1 -- cr10a : credencial
acc10a1 -- zvip : zona
acc10a1 -- sergio : validador

note bottom of zvip
Antes: /ocupacionActual = 1.199 de 1.200.
La entrada permitida alcanza 1.200: justo el aforo, no lo supera.
ACC-10A-0 acredita que Elena ya está dentro del recinto general, requisito para entrar en una zona interior.
end note
@enduml