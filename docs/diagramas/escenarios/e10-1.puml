@startuml
!pragma layout smetana
title E-10.1 · Entrada al Patio VIP con perfil VIP y aforo disponible (válido, límite)
hide empty members
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam object {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontSize 13
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #D6B656
  FontSize 12
}
skinparam nodesep 30
skinparam ranksep 30

object "ed2027 : Edicion" as ed2027 {
  id = "ED-2027"
  nombre = "Azahar Sound 2027"
  anio = 2027
  fechaInicio = "21/05/2027"
  fechaFin = "23/05/2027"
  aforoMaximoJornada = 15000
}
object "zgen : Zona" as zgen {
  id = "Z-GEN"
  nombre = "Recinto general"
  tipo = "recinto general"
  aforoMaximo = 15000
  ubicacion = "Recinto Azahar"
  /ocupacionActual = 10000
}
object "zvip : Zona" as zvip {
  id = "Z-VIP"
  nombre = "Patio VIP"
  tipo = "VIP"
  aforoMaximo = 1200
  ubicacion = "Dentro del recinto general"
  /ocupacionActual = 1200
}
object "tcAV : TipoCredencial" as tcAV {
  id = "TC-AV-27"
  nombre = "Abono VIP 2027"
  destinatario = "público"
  validez = "todas las jornadas"
  perfilAcceso = "VIP"
}
object "elena : Usuario" as elena {
  id = "USR-10A"
  nombre = "Elena"
  fechaNacimiento = "10/04/2001"
  rol = "asistente"
}
object "cr10a : Credencial" as cr10a {
  codigo = "CR-10A"
  estado = "canjeada"
  nfcActual = "NFC-10A"
  estadoPulsera = "activa"
  /saldoActual = 0,00 €
  /saldoDisponible = 0,00 €
