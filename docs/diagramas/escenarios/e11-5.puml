@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>elena : Usuario</u>" as elena {
  id = "USR-11G"
  nombre = "Elena"
}
object "<u>cr11g : Credencial</u>" as cr11g {
  codigo = "CR-11G"
  estado = "anulada"
  nfcActual = "NFC-E"
  estadoPulsera = "bloqueada"
  /saldoActual = 15.00
}

elena -- cr11g : titular

note bottom of cr11g
Credencial anulada: no se puede canjear ni
reponer la pulsera. El saldo se conserva para
la devolución.
end note
@enduml
