@startuml
!pragma layout smetana
title E-11.3 · Asignar la pulsera B a otra credencial (rechazo)
hide empty members
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam object {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontSize 13
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #D6B656
  FontSize 12
}
skinparam nodesep 30
skinparam ranksep 30

object "ed2027 : Edicion" as ed2027 {
  id = "ED-2027"
  nombre = "Azahar Sound 2027"
  anio = 2027
  fechaInicio = "21/05/2027"
  fechaFin = "23/05/2027"
  aforoMaximoJornada = 15000
}
object "tcAG : TipoCredencial" as tcAG {
  id = "TC-AG-27"
  nombre = "Abono General 2027"
  destinatario = "público"
  validez = "todas las jornadas"
  perfilAcceso = "general"
}
object "elena : Usuario" as elena {
  id = "USR-11C"
  nombre = "Elena"
  fechaNacimiento = "10/04/2001"
  rol = "asistente"
}
object "cr11c : Credencial" as cr11c {
  codigo = "CR-11C"
  estado = "canjeada"
  nfcActual = "NFC-B"
  estadoPulsera = "activa"
  /saldoActual = 15,00 €
  /saldoDisponible = 15,00 €
}
object "lucia : Usuario" as lucia {
  id = "USR-11D"
  nombre = "Lucía"
  fechaNacimiento = "18/11/2000"
  rol = "asistente"
}
object "cr11d : Credencial" as cr11d {
  codigo = "CR-11D"
  estado = "canjeada"
  nfcActual = "NFC-C"
  estadoPulsera = "activa"
  /saldoActual = 8,00 €
  /saldoDisponible = 8,00 €
}

ed2027 -- tcAG : edicion
tcAG -- cr11c : tipoCredencial
tcAG -- cr11d : tipoCredencial
elena -- cr11c : titular
lucia -- cr11d : titular

note bottom of cr11c
NFC-B ya está asignada a CR-11C. Se intenta asignarla a CR-11D.
Rechazado: el código NFC es único cuando existe, esté la pulsera activa o bloqueada.
CR-11D conserva NFC-C y CR-11C conserva NFC-B.
end note
@enduml