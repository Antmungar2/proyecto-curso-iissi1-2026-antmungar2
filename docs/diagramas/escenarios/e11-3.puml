@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>cr11c : Credencial</u>" as cr11c {
  codigo = "CR-11C"
  estado = "canjeada"
  nfcActual = "NFC-B"
  estadoPulsera = "activa"
}
object "<u>cr11d : Credencial</u>" as cr11d {
  codigo = "CR-11D"
  estado = "canjeada"
  nfcActual = "NFC-C"
  estadoPulsera = "activa"
}

note bottom of cr11d
Se intenta asignar NFC-B a CR-11D, pero ya
pertenece a CR-11C. NFC duplicado: operación
rechazada y ninguna credencial cambia.
end note
@enduml
