@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>cr10f : Credencial</u>" as cr10f {
  codigo = "CR-10F"
  estado = "canjeada"
  nfcActual = "NFC-10F"
  estadoPulsera = "bloqueada"
}
object "<u>zgen : Zona</u>" as zgen {
  nombre = "Recinto general"
  aforoMaximo = 15000
  /ocupacionActual = 9999
}
object "<u>acc10f1 : Acceso</u>" as acc10f1 {
  id = "ACC-10F-1"
  tipoMovimiento = "salida"
  resultado = "permitido"
  motivo = "salida asistida"
}
object "<u>acc10f2 : Acceso</u>" as acc10f2 {
  id = "ACC-10F-2"
  tipoMovimiento = "entrada"
  resultado = "denegado"
  motivo = "pulsera bloqueada"
}

acc10f1 -- cr10f : credencial
acc10f2 -- cr10f : credencial
acc10f1 -- zgen : zona
acc10f2 -- zgen : zona

note bottom of cr10f
La salida asistida se permite y baja la ocupación a 9.999;
el reingreso se deniega porque la pulsera está bloqueada
y no modifica la ocupación.
end note
@enduml
