@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>elena : Usuario</u>" as elena {
  id = "USR-11A"
  nombre = "Elena"
}
object "<u>cr11a : Credencial</u>" as cr11a {
  codigo = "CR-11A"
  estado = "canjeada"
  nfcActual = "NFC-B"
  estadoPulsera = "activa"
  /saldoActual = 15.00
}
object "<u>acc11a0 : Acceso</u>" as acc11a0 {
  id = "ACC-11A-0"
  tipoMovimiento = "entrada"
  resultado = "permitido"
}
object "<u>zcarpa : Zona</u>" as zcarpa {
  nombre = "Carpa Alameda"
  aforoMaximo = 2500
  /ocupacionActual = 1800
}

elena -- cr11a : titular
cr11a -- acc11a0 : accesos
acc11a0 -- zcarpa : zona

note bottom of cr11a
Antes la pulsera era NFC-A. La reposición deja
NFC-B activa; el saldo y la presencia en la Carpa
se mantienen.
end note
@enduml
