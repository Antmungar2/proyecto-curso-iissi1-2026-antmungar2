@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>cr10c : Credencial</u>" as cr10c {
  codigo = "CR-10C"
  estado = "canjeada"
  nfcActual = "NFC-10C"
  estadoPulsera = "activa"
}
object "<u>tcEV : TipoCredencial</u>" as tcEV {
  nombre = "Entrada de viernes 2027"
  perfilAcceso = "general"
  validez = "21/05/2027"
}
object "<u>zgen : Zona</u>" as zgen {
  nombre = "Recinto general"
  aforoMaximo = 15000
  /ocupacionActual = 10000
}
object "<u>acc10c1 : Acceso</u>" as acc10c1 {
  id = "ACC-10C-1"
  fechaHora = "22/05/2027 18:00"
  tipoMovimiento = "entrada"
  resultado = "denegado"
  motivo = "credencial fuera de su jornada"
}

cr10c -- tcEV : tipoCredencial
acc10c1 -- cr10c : credencial
acc10c1 -- zgen : zona

note bottom of tcEV
Entrada de viernes usada el sábado: la jornada
no está cubierta. Acceso denegado.
end note
@enduml
