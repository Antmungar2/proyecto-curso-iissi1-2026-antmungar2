@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 25
skinparam ranksep 30
left to right direction

object "<u>cr10d : Credencial</u>" as cr10d {
  codigo = "CR-10D"
  estado = "canjeada"
  nfcActual = "NFC-10D"
  estadoPulsera = "activa"
}
object "<u>cr10e : Credencial</u>" as cr10e {
  codigo = "CR-10E"
  estado = "canjeada"
  nfcActual = "NFC-10E"
  estadoPulsera = "activa"
}
object "<u>zcarpa : Zona</u>" as zcarpa {
  nombre = "Carpa Alameda"
  aforoMaximo = 2500
  /ocupacionActual = 2500
}
object "<u>acc10d1 : Acceso</u>" as acc10d1 {
  id = "ACC-10D-1"
  tipoMovimiento = "entrada"
  resultado = "denegado"
  motivo = "aforo completo"
}
object "<u>acc10d2 : Acceso</u>" as acc10d2 {
  id = "ACC-10D-2"
  tipoMovimiento = "salida"
  resultado = "permitido"
}
object "<u>acc10d3 : Acceso</u>" as acc10d3 {
  id = "ACC-10D-3"
  tipoMovimiento = "entrada"
  resultado = "permitido"
}

acc10d1 -- cr10d : credencial
acc10d2 -- cr10e : credencial
acc10d3 -- cr10d : credencial
acc10d1 -- zcarpa : zona
acc10d2 -- zcarpa : zona
acc10d3 -- zcarpa : zona

note bottom of zcarpa
Con 2.500/2.500 la entrada se deniega. Una salida
baja la ocupación a 2.499 y el reintento se permite.
La ocupación final vuelve a 2.500.
end note
@enduml
