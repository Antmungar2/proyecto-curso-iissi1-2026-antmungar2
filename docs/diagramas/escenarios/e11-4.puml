@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>lucia : Usuario</u>" as lucia {
  id = "USR-11E"
  nombre = "Lucía"
}
object "<u>marta : Usuario</u>" as marta {
  id = "USR-11F"
  nombre = "Marta"
}
object "<u>cr11e : Credencial</u>" as cr11e {
  codigo = "CR-11E"
  estado = "emitida"
  /saldoActual = 0.00
}
object "<u>cr11f : Credencial</u>" as cr11f {
  codigo = "CR-11F"
  estado = "canjeada"
  nfcActual = "NFC-F"
  fechaHoraPrimerCanje = "21/05/2027 12:00"
  /saldoActual = 5.00
}
object "<u>mv11f : MovimientoSaldo</u>" as mv11f {
  id = "MOV-11F"
  tipoMovimiento = "recarga"
  importe = 5.00
}

marta -- cr11e : titular
lucia -- cr11f : titular
cr11f -- mv11f : movimientos

note bottom of cr11e
CR-11E pasa de Lucía a Marta: es válido porque
no se ha canjeado ni tiene movimientos.
CR-11F se rechaza: ya está canjeada y tiene recargas.
end note
@enduml
