@startuml
!pragma layout smetana
title E-11.4 · Cambio de titular antes del canje (válido) y después (rechazo)
hide empty members
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam object {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontSize 13
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #D6B656
  FontSize 12
}
skinparam nodesep 30
skinparam ranksep 30

object "ed2027 : Edicion" as ed2027 {
  id = "ED-2027"
  nombre = "Azahar Sound 2027"
  anio = 2027
  fechaInicio = "21/05/2027"
  fechaFin = "23/05/2027"
  aforoMaximoJornada = 15000
}
object "tcAG : TipoCredencial" as tcAG {
  id = "TC-AG-27"
  nombre = "Abono General 2027"
  destinatario = "público"
  validez = "todas las jornadas"
  perfilAcceso = "general"
}
object "lucia : Usuario" as lucia {
  id = "USR-11E"
  nombre = "Lucía"
  fechaNacimiento = "18/11/2000"
  rol = "asistente"
}
object "marta : Usuario" as marta {
  id = "USR-11F"
  nombre = "Marta"
  fechaNacimiento = "09/12/1999"
  rol = "asistente"
}
object "cr11e : Credencial" as cr11e {
  codigo = "CR-11E"
  estado = "emitida"
  nfcActual = "null"
  estadoPulsera = "null"
  /saldoActual = 0,00 €
  /saldoDisponible = 0,00 €
}
object "cr11f : Credencial" as cr11f {
  codigo = "CR-11F"
  estado = "canjeada"
  nfcActual = "NFC-F"
  estadoPulsera = "activa"
  /saldoActual = 5,00 €
  /saldoDisponible = 5,00 €
}
object "mv11f : MovimientoSaldo" as mv11f {
  id = "MV-11F-1"
  fechaHora = "20/05/2027 12:00"
  tipoMovimiento = "recarga"
  importe = 5,00 €
  canal = "web"
}

ed2027 -- tcAG : edicion
tcAG -- cr11e : tipoCredencial
tcAG -- cr11f : tipoCredencial
marta -- cr11e : titular
lucia -- cr11f : titular
cr11f -- mv11f : movimientos

note bottom of cr11e
CR-11E está emitida, sin canje ni movimientos: se cambia el titular de Lucía a Marta (válido si cumple R.N.03 y R.N.05).
CR-11F ya tiene canje y una recarga de 5,00 €: se rechaza el cambio de titular.
end note
@enduml