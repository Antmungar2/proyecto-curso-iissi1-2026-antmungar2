@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>cr10b : Credencial</u>" as cr10b {
  codigo = "CR-10B"
  estado = "canjeada"
  nfcActual = "NFC-10B"
  estadoPulsera = "activa"
}
object "<u>tcAG : TipoCredencial</u>" as tcAG {
  nombre = "Abono General 2027"
  perfilAcceso = "general"
  validez = "todas las jornadas"
}
object "<u>zvip : Zona</u>" as zvip {
  nombre = "Patio VIP"
  aforoMaximo = 1200
  /ocupacionActual = 800
}
object "<u>acc10b1 : Acceso</u>" as acc10b1 {
  id = "ACC-10B-1"
  tipoMovimiento = "entrada"
  resultado = "denegado"
  motivo = "perfil general sin acceso a zona VIP"
}

cr10b -- tcAG : tipoCredencial
acc10b1 -- cr10b : credencial
acc10b1 -- zvip : zona

note bottom of zvip
Perfil general en una zona VIP: acceso denegado.
La ocupación del Patio VIP no cambia.
end note
@enduml
