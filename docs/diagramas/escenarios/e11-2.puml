@startuml
!pragma layout smetana
hide empty members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam object {
  BackgroundColor #F1F1F1
  BorderColor #181818
  FontSize 14
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #181818
  FontSize 13
}
skinparam nodesep 30
skinparam ranksep 35
left to right direction

object "<u>cr11b : Credencial</u>" as cr11b {
  codigo = "CR-11B"
  estado = "canjeada"
  nfcActual = "NFC-B"
  estadoPulsera = "activa"
  /saldoActual = 15.00
}
object "<u>prCerveza : Producto</u>" as prCerveza {
  nombre = "Cerveza"
  precioActual = 3.50
  stock = 50
}
object "<u>pv01 : PuntoVenta</u>" as pv01 {
  nombre = "Barra Azahar"
  tipo = "barra"
}

pv01 -- prCerveza : productos

note bottom of cr11b
Se lee la pulsera antigua NFC-A, que ya no es
la actual. Cobro rechazado: no se crea
MovimientoSaldo y el stock no cambia.
end note
@enduml
